{
  "name": "osrs-merch-planner",
  "productName": "OSRS Merch Planner",
  "version": "0.1.0",
  "description": "Personal Grand Exchange merching planner for Old School RuneScape",
  "main": "main.js",
  "license": "GPL-3.0",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "smoke:live": "node test/live-smoke.js",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.osrs.merchplanner",
    "productName": "OSRS Merch Planner",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "assets/icon.png",
      "src/**/*",
      "src-main/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "OSRS-Merch-Planner-Setup-${version}.${ext}"
    }
  },
  "allowScripts": {
    "electron@45.2.1": true
  },
  "author": "williamstylerg",
  "repository": {
    "type": "git",
    "url": "https://github.com/williamstylerg/OSRS_Merching_Tool.git"
  }
}
